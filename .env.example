# Copy to .env and edit. The .env file is git-ignored: never commit it.
# Run with: npm run build && npm start   (start reads .env when it exists)

# --- Required ---------------------------------------------------------------------------------

# The Solana wallet that receives every payment. This is a public address: Quitado never holds a
# private key.
QUITADO_RECIPIENT=

# The secret you type to sign in to the owner area. At least 20 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
QUITADO_ACCESS_SECRET=

# --- Common -----------------------------------------------------------------------------------

# mainnet-beta (real USDC and USDT, built in) or devnet (a test token you provide, see below).
QUITADO_CLUSTER=mainnet-beta

# Public address of this instance, without a path. Used for payment links and the origin check.
# Use https in production. On Railway, leave it out: the generated domain is used.
QUITADO_BASE_URL=http://localhost:3000

# Shown as "From" on invoices and as the label in the customer's wallet.
# QUITADO_OWNER_NAME=Your Name

# A paid RPC endpoint is more reliable than the public one. The URL may contain an API key:
# keep it in this file only.
# QUITADO_RPC_URL=

# --- Optional ---------------------------------------------------------------------------------

# QUITADO_HOST=127.0.0.1            # bind address; use 0.0.0.0 in a container
# QUITADO_PORT=3000                # PORT is used when this is not set (hosting platforms set it)
# QUITADO_DB_PATH=./data/quitado.db
# QUITADO_POLL_INTERVAL_SECONDS=10  # how often open invoices are checked on chain
# QUITADO_COMMITMENT=finalized      # or confirmed: faster, but a payment could in theory be rolled back
# QUITADO_UTC_OFFSET_MINUTES=0      # due dates end at 23:59:59 in this offset; Brazil is -180
# QUITADO_TRUST_PROXY=false         # true only behind a reverse proxy you control (reads X-Forwarded-For)

# Optional: a second host name served by this same process that shows the project's home page at "/"
# (and sends every other path to QUITADO_BASE_URL). Leave it out for a normal instance.
# QUITADO_SITE_HOST=example.com

# --- Devnet only ------------------------------------------------------------------------------

# Test tokens, as SYMBOL:mint:decimals, comma separated. Required on devnet, refused on mainnet-beta.
# QUITADO_ASSETS=TEST:<mint address>:6
